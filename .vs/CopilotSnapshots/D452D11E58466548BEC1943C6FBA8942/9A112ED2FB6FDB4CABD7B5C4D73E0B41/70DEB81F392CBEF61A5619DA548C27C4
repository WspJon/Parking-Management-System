Imports System.Data
Imports System.Collections.Generic

Module ParkingData
    ' This holds our list of parked cars
    Public ParkingTable As New DataTable()

    ' Global slots dictionary (True = Available, False = Occupied)
    Public parkingDatabase As New Dictionary(Of String, Boolean)()

    ' Total number of spaces in our parking lot
    Public MaxSlots As Integer = 70 ' 50 Cars + 20 Motorcycles
    Public OccupiedSlots As Integer = 0

    ' This creates the table structure and slot allocations when the program starts
    Public Sub InitializeDatabase()
        If ParkingTable.Columns.Count = 0 Then
            ParkingTable.Columns.Add("Slot", GetType(String))
            ParkingTable.Columns.Add("PlateNumber", GetType(String))
            ParkingTable.Columns.Add("VehicleType", GetType(String))
            ParkingTable.Columns.Add("TimeIn", GetType(DateTime))
            ParkingTable.Columns.Add("TimeOut", GetType(DateTime))
            ParkingTable.Columns.Add("Fee", GetType(Double))
            ParkingTable.Columns.Add("Status", GetType(String))
        End If

        ' Initialize slots if empty
        If parkingDatabase.Count = 0 Then
            ' Create Car Slots (G1 to G25, U1 to U25)
            For i As Integer = 1 To 25
                parkingDatabase.Add($"G{i}", True)
                parkingDatabase.Add($"U{i}", True)
            Next

            ' Create Motorcycle Slots (G26 to G35, U26 to U35)
            For i As Integer = 26 To 35
                parkingDatabase.Add($"G{i}", True)
                parkingDatabase.Add($"U{i}", True)
            Next
        End If
    End Sub
End Module
