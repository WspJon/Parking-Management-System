Imports System.Windows.Forms
Imports System.Drawing

Public Class Form1
    Private Sub btnLogin_Click(sender As Object, e As EventArgs) Handles btnLogin.Click
        Dim username = txtUsername.Text.Trim()
        Dim password = txtPassword.Text

        Dim authenticated As Boolean = False

        ' If there are saved users, authenticate against them
        If DataStore.UsersTable IsNot Nothing AndAlso DataStore.UsersTable.Rows.Count > 0 Then
            For Each r As DataRow In DataStore.UsersTable.Rows
                Dim savedUser = r("Username").ToString().Trim()
                Dim savedPass = r("Password").ToString().Trim()
                If String.Equals(savedUser, username, StringComparison.OrdinalIgnoreCase) AndAlso savedPass = password.Trim() Then
                    authenticated = True
                    Exit For
                End If
            Next
        Else
            ' Fallback to default admin account when no users saved
            If username = "admin" AndAlso password = "1234" Then
                authenticated = True
            End If
        End If

        If authenticated Then
            MessageBox.Show("Welcome to the Parking System!", "Login Success")
            menufrm.Show()
            Me.Hide()
        Else
            MessageBox.Show("Invalid Username or Password. Please try again.", "Login Failed", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End If
    End Sub

    Private Sub Form1_Load(sender As Object, e As EventArgs) Handles MyBase.Load
        ' Enable window dragging on the header panel
        ThemeManager.EnableDrag(Panel1, Me)

        ' Apply flat styles and rounded corners
        ThemeManager.StyleButton(btnLogin, ThemeManager.TealAccent)
        ThemeManager.MakeRoundedControl(btnLogin, 6)
        ThemeManager.MakeRoundedControl(btnClose, 6)

        ' Style close button and hover animation
        ThemeManager.StyleButton(btnClose, Color.Transparent)
        AddHandler btnClose.MouseEnter, Sub() btnClose.BackColor = ThemeManager.RedExit
        AddHandler btnClose.MouseLeave, Sub() btnClose.BackColor = Color.Transparent
        
        ' Bind close button click
        AddHandler btnClose.Click, Sub() Me.Close()

        ' Load persisted data and ensure save on application exit
        Try
            DataStore.LoadAll()
        Catch
        End Try

        Try
            AddHandler Application.ApplicationExit, AddressOf DataStore.SaveAll
        Catch
        End Try

        ' Bind create account button
        AddHandler btnCreateAccount.Click, AddressOf btnCreateAccount_Click
    End Sub

    Private Sub btnCreateAccount_Click(sender As Object, e As EventArgs)
        Dim user = InputBox("Enter new username:", "Create Account").Trim()
        If String.IsNullOrWhiteSpace(user) Then
            MessageBox.Show("Username cannot be empty.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return
        End If

        Dim pass = InputBox("Enter password for user (will be stored plain-text):", "Create Account")
        If String.IsNullOrEmpty(pass) Then
            MessageBox.Show("Password cannot be empty.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning)
            Return
        End If

        DataStore.EnsureUsersTable()

        ' Check uniqueness
        For Each r As DataRow In DataStore.UsersTable.Rows
            If String.Equals(r("Username").ToString(), user, StringComparison.OrdinalIgnoreCase) Then
                MessageBox.Show("Username already exists.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Warning)
                Return
            End If
        Next

        Dim newRow As DataRow = DataStore.UsersTable.NewRow()
        newRow("Username") = user
        newRow("Password") = pass
        DataStore.UsersTable.Rows.Add(newRow)
        Try
            DataStore.SaveAll()
        Catch
        End Try

        MessageBox.Show("Account created successfully.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

    Private Sub Form1_FormClosing(sender As Object, e As FormClosingEventArgs) Handles Me.FormClosing
        ' If closed via the "X" button, return to the main gate lobby
        If e.CloseReason = CloseReason.UserClosing Then
            menufrm.Show()
        End If
    End Sub
End Class
